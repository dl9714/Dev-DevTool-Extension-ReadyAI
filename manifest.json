{
  "manifest_version": 3,
  "name": "Ready_Ai",
  "version": "0.2.40",
  "description": "AI 답변 완료 알림, 탭 이름 관리, 후속 지시 성능 업그레이드",
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/content/chatgpt-bootstrap.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/bell_profile.png",
      "32": "assets/bell_profile.png",
      "48": "assets/bell_profile.png",
      "128": "assets/bell_profile.png"
    }
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "scripting",
    "webNavigation",
    "alarms",
    "idle",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "assets/bell_profile.png",
    "32": "assets/bell_profile.png",
    "48": "assets/bell_profile.png",
    "128": "assets/bell_profile.png"
  }
}
